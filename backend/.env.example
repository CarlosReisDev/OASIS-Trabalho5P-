# Credenciais do Oracle na nuvem
ORA_USER=ADMIN
ORA_PASSWORD=sua_senha

# Com WALLET (Autonomous DB): use o ALIAS do tnsnames.ora (ex.: meudb_high)
# Sem wallet: host.adb.regiao.oraclecloud.com:1522/servicename
ORA_CONNECT_STRING=meudb_high

# WALLET: pasta onde voce descompactou o wallet (contem tnsnames.ora, ewallet.pem...)
ORA_WALLET_DIR=./wallet
# Senha definida ao baixar o wallet no console da Oracle (necessaria no modo Thin)
ORA_WALLET_PASSWORD=senha_do_wallet

# Porta da API
PORT=3001

# Instant Client (so no modo Thick; com wallet no modo Thin deixe vazio)
ORA_CLIENT_LIB_DIR=
